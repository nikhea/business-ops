{
  "name": "bussiness ops",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "PORT=$MASTRA_PORT mastra dev",
    "google:auth": "bun run scripts/google-oauth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bun x auth@latest generate --config src/auth/index.ts --adapter drizzle --dialect postgresql --output src/db/schema/auth.ts",
    "admin:create": "bun x auth@latest create-admin --config src/auth/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@chat-adapter/slack": "^4.43.0",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@mastra/core": "^1.79.0",
    "@mastra/editor": "^0.16.4",
    "@mastra/hono": "^1.7.21",
    "@mastra/loggers": "^1.3.9",
    "@mastra/mcp": "^2.5.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/observability": "^1.21.0",
    "@mastra/pg": "^1.32.0",
    "@mastra/tavily": "^1.1.3",
    "@tavily/core": "^0.7.14",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mastra": "^1.35.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  }
}